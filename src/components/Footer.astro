---
const GITHUB_REPOSITORY_URL='https://github.com/avolaunch/relay-protocol';
---
<footer><div class="wrap footer-inner"><div><p class="footer-brand">Relay Protocol</p><p class="footer-tagline">Open protocol development in progress.</p></div><div class="footer-right"><a href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">GitHub</a><p class="footer-note">The specification is under development and subject to change.</p></div></div></footer>
<style>footer{border-top:1px solid var(--border);padding-block:2.5rem}.footer-inner{display:flex;flex-wrap:wrap;justify-content:space-between;gap:1.5rem}.footer-brand{font-family:var(--font-mono);font-size:.9375rem;color:var(--text);margin:0 0 .25rem}.footer-tagline{font-size:.875rem;color:var(--text-faint);margin:0}.footer-right{text-align:right}.footer-right a{font-family:var(--font-mono);font-size:.875rem}.footer-note{font-size:.8125rem;color:var(--text-faint);max-width:16rem;margin:.5rem 0 0}@media(max-width:30rem){.footer-right{text-align:left}.footer-note{max-width:none}}</style>
